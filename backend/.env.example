# SUECA PROSPECT RADAR — backend environment
# Copy to .env for local dev. No secrets are required to run locally on SQLite.

# Environment: "development" or "production". Production makes the session
# cookie Secure + SameSite=None (cross-site) and requires a real access code.
APP_ENV=development

# --- Storage ---------------------------------------------------------------
# SQLite by default (real, persistent, zero-config). To use Supabase/Postgres,
# set DATABASE_URL to the "Session pooler" URI from Supabase (Project Settings
# -> Database -> Connect). The scheme is rewritten to +psycopg automatically.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Access gate -----------------------------------------------------------
# Signing key for the session cookie. Use a long random value in production.
# SESSION_SECRET=change-me-to-a-long-random-string
# The access code, stored ONLY as a SHA-256 hash. Generate with:
#   python scripts/make_access_hash.py "your access code"
# (Local dev without this uses the code "sueca".)
# ACCESS_CODE_HASH=

# --- CORS (production) -----------------------------------------------------
# Comma-separated allowed origins. In production set this to your Vercel URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Public-demo safety limits ---------------------------------------------
MAX_RESULTS_PER_RUN=60
MAX_ACTIVE_RUNS=1

# --- Public OSM data providers (free, no API key) --------------------------
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URLS=https://maps.mail.ru/osm/tools/overpass/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Keep the UA a clean token (no "Mozilla"/parentheses) — the main Overpass
# instance's WAF returns 406 for browser-like User-Agents.
USER_AGENT=SuecaProspectRadar/1.0

# --- Prospecting engine defaults (also editable in the Settings screen) ----
REQUEST_DELAY_SECONDS=1.2
MAX_CONCURRENCY=1
RESULT_LIMIT=60
RADIUS_METERS=12000
HTTP_TIMEOUT_SECONDS=60
